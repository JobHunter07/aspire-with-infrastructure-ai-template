{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "weather-forecast": {
        "ClusterId": "resource-server",
        "Match": {
          "Path": "/api/weatherforecast"
        },
        "AuthorizationPolicy": "authenticatedUser"
      }
    },
    "Clusters": {
      "resource-server": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7593/"
          }
        }
      }
    }
  }
}
